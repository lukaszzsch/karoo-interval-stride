<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <!-- Same tonal wash as the tiles, so it takes the watts range tint behind it -->
        <shape><solid android:color="@color/tile_tonal" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/text" /><corners android:radius="4dp" /></shape></clip>
    </item>
</layer-list>
