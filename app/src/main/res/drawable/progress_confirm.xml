<?xml version="1.0" encoding="utf-8"?>
<!-- Confirm move while a remote-made choice confirms itself: darker green, filling with the usual green -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/confirm_wait_bg" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/resume_bg" /><corners android:radius="8dp" /></shape></clip>
    </item>
</layer-list>
