<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown: the pale blue box, filling with the darker blue as the seconds run down. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/countdown_bg" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/countdown_fill" /><corners android:radius="8dp" /></shape></clip>
    </item>
</layer-list>
