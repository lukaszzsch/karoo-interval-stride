<?xml version="1.0" encoding="utf-8"?>
<!-- Filled heart (Tabler Icons "heart", MIT licence), cropped to the shape plus its stroke so the
     icon's bottom/top line up with the digits' baseline/cap height. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp" android:height="20dp"
    android:viewportWidth="22" android:viewportHeight="20">
    <!-- 1 unit of room on every side so the stroke's rounded tip and lobes aren't clipped -->
    <group android:translateX="-1" android:translateY="-2.5">
        <path
            android:pathData="M19.5,12.572L12,20l-7.5,-7.428A5,5 0,1 1,12 6.006a5,5 0,1 1,7.5 6.572"
            android:strokeColor="@color/heart_icon"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@color/heart_icon" />
    </group>
</vector>
