<?xml version="1.0" encoding="utf-8"?>
<!-- Karoo style: Confirm move while a remote-made choice confirms itself: Karoo yellow, filling with the darker yellow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/karoo_yellow" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/karoo_yellow_dark" /><corners android:radius="8dp" /></shape></clip>
    </item>
</layer-list>
