    <color name="range_bg_under_clear">#009FC7EF</color>
    <color name="range_bg_in">#FFB4CE95</color>
    <color name="range_bg_in_clear">#00B4CE95</color>
    <color name="range_bg_over">#FFF1A9A8</color>
    <color name="range_bg_over_clear">#00F1A9A8</color>
</resources>
