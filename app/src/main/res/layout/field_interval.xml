<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-page interval screen, rendered as RemoteViews (only framework layouts/widgets allowed).
  Sized for a Karoo 3 full page (about 255x385 dp). ScreenRenderer rescales text and the chart
  height for other field sizes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper part: watts, interval, progress and tiles. Its background is the optional
             target-range tint (third watts mode), which reaches the field's top and side edges and
             fades out halfway between the tiles and the Next box. -->
        <LinearLayout
            android:id="@+id/upper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

        <!-- Watts, centred (heart rate, settings and pause sit in the top row, see below) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Watts fill the area and shrink to fit it: Karoo makes the field shorter when, for
                 example, a route is loaded, without telling the app the new size. The top padding
                 keeps the digits clear of the heart rate row, which sits in the icon row above (the
                 font's own space above the digits adds to it). The negative bottom margin lets the
                 empty space below the digits run under the interval row, so the digits can grow. -->
            <TextView
                android:id="@+id/watts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="-8dp"
                android:autoSizeMaxTextSize="107sp"
                android:autoSizeMinTextSize="32sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingTop="24dp"
                android:textColor="@color/text"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Interval number + time left + progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- Interval number, or (while paused) a yellow box sized to its text -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/interval_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:id="@+id/paused_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_paused"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/paused_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pause_filled" />

                    <TextView
                        android:id="@+id/paused_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/paused_fg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/interval_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_interval" />

        <!-- Lap avg / Target tiles -->
        <LinearLayout
            android:id="@+id/tiles_row"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lap_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile_tonal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/lap_avg_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lap_avg"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/lap_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/target_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile_tonal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/target_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/target_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cadence: live rpm, coloured against the step's target (hidden without either) -->
            <LinearLayout
                android:id="@+id/cad_tile"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile_tonal"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/cad_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cadence"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/cad_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- While choosing a jump: a small ✕ and "Confirm move" (right, above ⏭) in place of the tiles -->
        <LinearLayout
            android:id="@+id/confirm_row"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btn_confirm_x"
                android:layout_width="48dp"
                android:layout_marginEnd="6dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tile_tonal">

                <ImageView
                    android:id="@+id/th_interval_1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_cancel_jump"
                    android:src="@drawable/ic_x"
                    android:tint="@color/text" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_confirm">

            <!-- Fills up while a remote-made choice confirms itself -->
            <ProgressBar
                android:id="@+id/confirm_fill"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progressDrawable="@drawable/progress_confirm"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/th_interval_2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/resume_fg" />

                <TextView
                    android:id="@+id/confirm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_move"
                    android:textColor="@color/resume_fg"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- "Move cancelled" after the ✕ next to Confirm move: same 52 dp, tap to hide -->
        <LinearLayout
            android:id="@+id/move_cancelled"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_info"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/th_interval_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/info_fg" />

            <TextView
                android:id="@+id/move_cancelled_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/move_cancelled"
                android:textColor="@color/info_fg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>

        <!-- Lower part: next interval / countdown and the chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp">

        <!-- "Next up" box: ⏮ near the left edge, ⏭ near the right edge, each with an invisible tap
             area covering its end of the box; centred text. While a jump is being chosen, a fill
             grows behind everything (3 steps) and tapping the middle cancels. -->
        <FrameLayout
            android:id="@+id/next_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_outline">

            <ImageView
                android:id="@+id/select_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_select_fill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_previous"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/th_interval_4"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_btn_pause">

                        <ImageView
                            android:id="@+id/th_interval_5"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_previous"
                            android:src="@drawable/ic_previous" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/next_mid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/next_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/next_value"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_skip"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:id="@+id/skip_bg"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_btn_skip">

                        <ImageView
                            android:id="@+id/skip_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_skip"
                            android:src="@drawable/ic_skip" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Jump countdown (replaces the Next up box): pale blue, filling with the darker blue as the
             seconds run down (countdown_fill); the number left, "Jumping to" and the step right,
             spaced like Next up (11sp label, 4dp gap, the step on a 20dp line up to 17sp). -->
        <FrameLayout
            android:id="@+id/countdown_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/countdown_fill"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progressDrawable="@drawable/progress_countdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/countdown_fg"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/countdown_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/jumping_to"
                        android:textColor="@color/countdown_sub"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/countdown_value"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="end|center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/countdown_fg"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_chart"
            android:scaleType="fitXY" />


        <!-- Free ride (no workout): the ride's power by zone, in the space of the next box and profile -->

        <ImageView

            android:id="@+id/free_chart"

            android:layout_width="match_parent"

            android:layout_height="110dp"

            android:scaleType="fitXY"

            android:visibility="gone"

            android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>

    <!-- Corner buttons on the outer layer, so they sit right in the corners. No background,
         48dp touch area each. -->
    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start">

        <ImageView
            android:id="@+id/th_interval_6"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            android:alpha="0.55"
            android:tint="@color/text" />
    </FrameLayout>

    <!-- ⓘ (indoors): the whole workout so far fills the field; a tap anywhere closes it. Right
         of the gear, the same 48dp touch area. -->
    <FrameLayout
        android:id="@+id/btn_info"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="40dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_info_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="9dp"
            android:contentDescription="@string/cd_info"
            android:src="@drawable/ic_info" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/btn_pause_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_pause"
            android:src="@drawable/ic_pause" />
    </FrameLayout>

    <!-- Heart rate, centred on the same line as the gear and pause icons (40dp row: icons are
         24dp, 8dp from the top, clear of Karoo's swipe-down strip). -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <!-- Bottom on the text baseline; the heart itself is about as tall as the digits -->
                <ImageView
                    android:id="@+id/th_interval_7"
                    android:layout_width="15.5dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:baselineAlignBottom="true"
                    android:contentDescription="@string/cd_heart_rate"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_heart" />

                <TextView
                    android:id="@+id/hr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
    </FrameLayout>

    <!-- Resume button while you've paused the workout: a green half-pill, rounded on the left and
         flat against the screen edge. Replaces the small pause button. -->
    <FrameLayout
        android:id="@+id/btn_resume"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_resume"
        android:visibility="gone">

        <ImageView
            android:id="@+id/th_interval_8"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/cd_resume"
            android:src="@drawable/ic_play_filled"
            android:tint="@color/resume_fg" />
    </FrameLayout>
</FrameLayout>
