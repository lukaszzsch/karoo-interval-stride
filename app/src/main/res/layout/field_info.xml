<?xml version="1.0" encoding="utf-8"?>
<!--
  ⓘ on the workout screen (indoors): the whole workout so far, drawn as one picture by
  ScreenRenderer.renderInfo. Kept to its aspect (fitStart) so a route, which makes the field
  shorter without telling the app, can't squash it. A tap anywhere closes it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/info_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitStart" />
</FrameLayout>
