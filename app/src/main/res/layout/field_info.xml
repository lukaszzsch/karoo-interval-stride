<?xml version="1.0" encoding="utf-8"?>
<!--
  ⓘ: the whole workout so far, or the lap / whole ride without a workout, drawn as one picture
  by ScreenRenderer.renderInfo. Kept to its aspect (fitStart) so a route, which makes the field
  shorter without telling the app, can't squash it. info_close lies over the drawn ✕ (it closes
  the panel); a tap elsewhere closes it in a workout, switches lap / whole ride without one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/info_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitStart" />

    <View
        android:id="@+id/info_close"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent" />
</FrameLayout>
