<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loads planned workouts from Stride -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ERG: drive a smart trainer over Bluetooth FTMS -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- To tell the rider to enable Wi-Fi when there's no connection to sync over -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- To sync as soon as Wi-Fi connects -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:icon="@drawable/ic_interval"
        android:label="@string/app_name">

        <!-- Setup: Stride API token and picking today's workout -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/AppTheme" />

        <!-- First-run introduction (shown once; Settings can show it again) -->
        <activity
            android:name=".IntroActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme" />

        <!-- Ride rating (RPE and feel), opened from the "Rate" notification -->
        <activity
            android:name=".RateActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:label="@string/rate_title"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="com.daviddokakis.karoointerval.stride.RATE_RIDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A workout's details: picture, numbers, zones, intervals (a tap on its card) -->
        <activity
            android:name=".WorkoutDetailsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".TrainerActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:label="@string/account_title"
            android:theme="@style/AppTheme" />

        <service
            android:name=".IntervalExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Lets the Karoo system discover this extension -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Receives taps on the skip / pause buttons drawn in the data field -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />
    </application>
</manifest>
